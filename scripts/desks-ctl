#!/usr/bin/env bash
# Unified Desks control script: installs, removes, and drives the Hyprland side.
set -euo pipefail

PLUGIN_ID="io.github.azcoov.unified-desks"
PLUGIN_DIR="${HOME}/.config/omarchy/plugins/${PLUGIN_ID}"
HYPR_DIR="${HOME}/.config/hypr"
STATE_DIR="${HOME}/.local/state/${PLUGIN_ID}"
TARGET_LUA="${HYPR_DIR}/unified-desks.lua"
HYPRLAND_LUA="${HYPR_DIR}/hyprland.lua"
PAYLOAD_LUA="${PLUGIN_DIR}/hypr/unified-desks.lua"
CONFIG_FILE="${HOME}/.config/omarchy/unified-desks.conf"
DEFAULT_DESKS=5
BEGIN_MARK="-- BEGIN ${PLUGIN_ID}"
END_MARK="-- END ${PLUGIN_ID}"

die() { echo "unified-desks: $*" >&2; exit 1; }

# --- safe filesystem helpers -------------------------------------------------
#
# Every path this plugin owns lives at a predictable, world-known location, so a
# plain `> "$dest"` redirect would follow a symlink planted there and clobber
# whatever it points at. These helpers refuse to write through a symlink or any
# non-regular file, and publish content by atomic rename into the destination
# directory, so a swap racing the write cannot redirect it either.

# A directory this plugin owns: must not be a symlink.
ensure_own_dir() {
  local dir="$1"
  [[ -L "$dir" ]] && die "refusing to use ${dir}: it is a symlink"
  mkdir -p "$dir"
  [[ -d "$dir" ]] || die "not a directory: ${dir}"
  return 0
}

# safe_write <dest> [mode]   -- content on stdin
safe_write() {
  local dest="$1" mode="${2:-0644}" dir tmp
  dir="$(dirname "$dest")"
  ensure_own_dir "$dir"

  [[ -L "$dest" ]] && die "refusing to write ${dest}: it is a symlink"
  if [[ -e "$dest" && ! -f "$dest" ]]; then
    die "refusing to write ${dest}: not a regular file"
  fi

  tmp="$(mktemp "${dir}/.unified-desks.XXXXXXXX")" || die "cannot create temp file in ${dir}"
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$dest"
}

# True when dest is missing or differs from the given content file.
needs_update() {
  local src="$1" dest="$2"
  [[ -L "$dest" ]] && return 0          # symlink: safe_write will reject it loudly
  [[ -f "$dest" ]] || return 0
  ! cmp -s "$src" "$dest"
}

monitor_count() {
  hyprctl monitors -j 2>/dev/null \
    | jq '[.[] | select((.disabled // false) == false)] | length' 2>/dev/null || echo 0
}

backup_once() {
  local file="$1" name
  name="$(basename "$file")"
  ensure_own_dir "${STATE_DIR}/originals"
  if [[ -f "$file" && ! -e "${STATE_DIR}/originals/${name}" ]]; then
    safe_write "${STATE_DIR}/originals/${name}" 0644 <"$file"
  fi
  return 0
}

# --- commands ----------------------------------------------------------------

cmd_install() {
  [[ -d "$HYPR_DIR" ]] || die "no ${HYPR_DIR} -- is this Omarchy?"
  [[ -f "$PAYLOAD_LUA" ]] || die "plugin payload missing at ${PAYLOAD_LUA}"

  local count changed=0
  count="$(monitor_count)"
  if [[ "$count" != "2" ]]; then
    echo "unified-desks: ${count} monitor(s) connected; this plugin is for exactly 2."
    echo "unified-desks: installing anyway -- it stays inert until 2 are connected."
  fi

  backup_once "$HYPRLAND_LUA"

  # Only touch the filesystem when something actually differs. The shell runs
  # this on every start, and a no-op start should write nothing at all.
  if needs_update "$PAYLOAD_LUA" "$TARGET_LUA"; then
    safe_write "$TARGET_LUA" 0644 <"$PAYLOAD_LUA"
    changed=1
  fi

  # Idempotent fenced require so re-running never stacks duplicates.
  #
  # This runs through append-fence.py rather than a `>>` redirect. A redirect
  # resolves the path at open time and follows any symlink sitting there, and
  # testing with `[[ -L ]]` first is a time-of-check/time-of-use race. The
  # helper opens once with O_NOFOLLOW, which refuses a symlink in the same
  # syscall, and does the "already present?" check on that same descriptor.
  local rc=0
  python3 "${PLUGIN_DIR}/scripts/append-fence.py" \
    "$HYPRLAND_LUA" "$BEGIN_MARK" "$END_MARK" 'require("hypr.unified-desks")' || rc=$?
  case "$rc" in
    0) changed=1 ;;
    3) : ;;  # already present
    4) die "refusing to modify ${HYPRLAND_LUA}: it is a symlink.
   If you keep hyprland.lua in a dotfiles repo, add this line to the real file:
       require(\"hypr.unified-desks\")" ;;
    5) die "cannot modify ${HYPRLAND_LUA}: missing or not a regular file" ;;
    *) die "failed to update ${HYPRLAND_LUA} (append-fence exit ${rc})" ;;
  esac

  write_standalone_restore && changed=1

  if (( changed )); then
    hyprctl reload >/dev/null 2>&1 || true
    echo "unified-desks: installed"
  else
    echo "unified-desks: already up to date"
  fi
}

# A self-contained restore helper that survives the plugin directory being
# deleted, so `omarchy plugin remove` before `restore` is still recoverable.
# Returns 0 only when it actually rewrote the file.
write_standalone_restore() {
  local target="${STATE_DIR}/restore.sh" tmp
  ensure_own_dir "$STATE_DIR"

  tmp="$(mktemp "${STATE_DIR}/.unified-desks.XXXXXXXX")" || die "cannot create temp file in ${STATE_DIR}"
  cat >"$tmp" <<RESTORE
#!/usr/bin/env bash
# Standalone Unified Desks restore. Safe to run after the plugin is removed.
set -euo pipefail
HYPRLAND_LUA="${HYPRLAND_LUA}"
TARGET_LUA="${TARGET_LUA}"
BEGIN_MARK="${BEGIN_MARK}"
END_MARK="${END_MARK}"

python3 - "\$HYPRLAND_LUA" "\$BEGIN_MARK" "\$END_MARK" <<'PY'
# Opened once with O_NOFOLLOW so a symlink planted at this path is refused
# rather than followed, and rewritten through the same descriptor.
import errno, os, stat, sys
path, begin, end = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
except OSError as exc:
    if exc.errno == errno.ELOOP:
        sys.exit("refusing to modify %s: it is a symlink" % path)
    if exc.errno == errno.ENOENT:
        sys.exit(0)
    raise
try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        sys.exit("refusing to modify %s: not a regular file" % path)
    data = b""
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        data += chunk
    out, skipping, removed = [], False, False
    for line in data.decode("utf-8").splitlines():
        if not skipping and line.strip() == begin:
            while out and out[-1].strip() == "":
                out.pop()
            skipping, removed = True, True
            continue
        if skipping:
            if line.strip() == end:
                skipping = False
            continue
        out.append(line)
    if removed:
        payload = ("\n".join(out) + "\n").encode("utf-8")
        os.lseek(fd, 0, os.SEEK_SET)
        os.write(fd, payload)
        os.ftruncate(fd, len(payload))
finally:
    os.close(fd)
PY

if [[ -L "\$TARGET_LUA" ]]; then
  echo "unified-desks: refusing to remove \$TARGET_LUA: it is a symlink" >&2
  exit 1
fi
rm -f "\$TARGET_LUA"
hyprctl reload >/dev/null 2>&1 || true
echo "unified-desks: restored"
RESTORE

  if [[ -f "$target" && ! -L "$target" ]] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    return 1
  fi

  [[ -L "$target" ]] && { rm -f "$tmp"; die "refusing to write ${target}: it is a symlink"; }
  if [[ -e "$target" && ! -f "$target" ]]; then
    rm -f "$tmp"
    die "refusing to write ${target}: not a regular file"
  fi

  chmod 0755 "$tmp"
  mv -f "$tmp" "$target"
  return 0
}

cmd_restore() {
  local rc=0
  python3 "${PLUGIN_DIR}/scripts/strip-fence.py" \
    "$HYPRLAND_LUA" "$BEGIN_MARK" "$END_MARK" || rc=$?
  case "$rc" in
    0) : ;;
    4) die "refusing to modify ${HYPRLAND_LUA}: it is a symlink.
   Remove this line from the real file by hand:
       require(\"hypr.unified-desks\")" ;;
    5) : ;;  # nothing there to clean up
    *) die "failed to clean ${HYPRLAND_LUA} (strip-fence exit ${rc})" ;;
  esac

  if [[ -L "$TARGET_LUA" ]]; then
    die "refusing to remove ${TARGET_LUA}: it is a symlink"
  fi
  rm -f "$TARGET_LUA"
  hyprctl reload >/dev/null 2>&1 || true
  echo "unified-desks: removed from Hyprland config (originals in ${STATE_DIR}/originals)"
}

cmd_switch() {
  # Range is 1..10 because the desk count is configurable; the Lua side rejects
  # anything above the configured count, so validate only the shape here.
  local desk="${1:-}"
  [[ "$desk" =~ ^([1-9]|10)$ ]] || die "switch needs a desk number 1-10"
  hyprctl eval "o.unified_desks.switch_desk(${desk})" >/dev/null 2>&1
}

cmd_status() {
  local desks="${DEFAULT_DESKS}"
  if [[ -f "$CONFIG_FILE" ]]; then
    local raw
    raw="$(head -n1 "$CONFIG_FILE" 2>/dev/null | tr -dc '0-9')"
    if [[ -n "$raw" ]] && (( raw >= 1 && raw <= 10 )); then desks="$raw"; fi
  fi
  echo "desks              : ${desks} (ws 1-${desks} left, $((desks + 1))-$((desks * 2)) right)"
  echo "config file        : $([[ -f "$CONFIG_FILE" ]] && echo "$CONFIG_FILE" || echo "none (default ${DEFAULT_DESKS})")"
  echo "monitors connected : $(monitor_count)"
  echo "lua installed      : $([[ -f "$TARGET_LUA" ]] && echo yes || echo no)"
  echo "hyprland.lua hook  : $(grep -qF -- "$BEGIN_MARK" "$HYPRLAND_LUA" 2>/dev/null && echo yes || echo no)"
  echo "workspace rules    : $(hyprctl workspacerules -j 2>/dev/null | jq 'length' 2>/dev/null || echo '?')"
}

case "${1:-}" in
  install) cmd_install ;;
  restore) cmd_restore ;;
  switch)  shift; cmd_switch "$@" ;;
  status)  cmd_status ;;
  *) die "usage: desks-ctl {install|restore|switch <1-5>|status}" ;;
esac
